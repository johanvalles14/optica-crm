# Generar un .env con ops/install-local.ps1. Nunca reutilizar estos valores.
POSTGRES_DB=optica_crm
POSTGRES_USER=optica
POSTGRES_PASSWORD=GENERAR_CON_OPS_INSTALL_LOCAL
OPTICA_CRM_PORT=3000
OPTICA_CRM_DATA_PATH=./data/postgres
OPTICA_CRM_BACKUP_PATH=./backups

# Producción local: autenticación real mediante Supabase Auth.
AUTH_MODE=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo para comandos Prisma ejecutados desde el host.
DATABASE_URL="postgresql://optica:CAMBIAR@localhost:5432/optica_crm?schema=public"
