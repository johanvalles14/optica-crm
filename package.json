{
  "name": "optica-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Óptica CRM - Gestión integral de pacientes, consultas optométricas y prescripciones.",
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.1",
    "postcss": "8.5.28"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File ops/smoke-local.ps1",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: no linter configured yet'",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "5.0.0",
    "magicast": "^0.3.5",
    "prisma": "6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/ssr": "^0.12.6",
    "next": "^15.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  }
}
