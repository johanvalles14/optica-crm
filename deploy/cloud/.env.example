# PostgreSQL administrado por el proveedor cloud. Nunca subir este archivo con credenciales.
DATABASE_URL=postgresql://usuario:contraseña@host-proveedor:5432/optica_crm?sslmode=require
OPTICA_CRM_IMAGE=registry.example.com/optica-crm:0.1.0
# Supabase valida la sesión y el middleware inyecta la identidad verificada.
AUTH_MODE=supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
